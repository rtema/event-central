# ==============================================================
# Vite SPA .htaccess
# - Serves index.html for all routes (client-side routing)
# - Leaves real files/dirs (assets/, robots.txt, favicon.ico) alone
# - Long-lived immutable caching for hashed build assets
# - No-cache for index.html so deploys are picked up immediately
# ==============================================================

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Don't rewrite real files or directories (covers assets/, robots.txt, favicon.ico, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Also explicitly leave anything under assets/ alone
  RewriteRule ^assets/ - [L]

  # Everything else falls back to the SPA entry point
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Hashed build assets: cache hard and forever (filename changes when content changes)
  <IfModule mod_rewrite.c>
    <If "%{REQUEST_URI} =~ m#^/assets/#">
      Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
  </IfModule>

  # index.html: never cache — always revalidate so users get the latest app shell
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  # Fallback expirations by type (used if a file slips past the rules above)
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 week"
  ExpiresByType font/woff2              "access plus 1 year"

  # HTML should stay fresh
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>
